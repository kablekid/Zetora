# ----------------------------------------------------------------------------
# Zetora environment variables.  Copy to .env.local and fill in.
# ----------------------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The *anon* / publishable key. Safe for the browser — RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Public URL of the site (used for e-mail links and SEO). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — shown on the Contact page / footer when set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_TELEGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# NOTE: Zetora never needs the Supabase service-role key. Do NOT add it here.
